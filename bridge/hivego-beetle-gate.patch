 // beetleMoves lists the valid moves for the Beetle located at the given position.
+// beetleGateAllows reports whether a beetle may step from srcPos to tgtPos
+// under Hive's "freedom to move" rule as it applies at height.
+//
+// The two hexes adjacent to both src and tgt form a gate. The beetle can pass
+// only if it can get over at least one of them: it is blocked exactly when
+// both gate stacks are strictly taller than both the level it drops to on the
+// source hex (i.e. after lifting itself off) and the level it climbs to on the
+// target hex.
+func (b *Board) beetleGateAllows(srcPos, tgtPos Pos) bool {
+	srcAfterLeaving := int(b.CountAt(srcPos)) - 1
+	tgtHeight := int(b.CountAt(tgtPos))
+	squeezeFloor := max(srcAfterLeaving, tgtHeight)
+
+	gateHeights := make([]int, 0, 2)
+	for _, n := range srcPos.Neighbours() {
+		for _, m := range tgtPos.Neighbours() {
+			if n == m {
+				gateHeights = append(gateHeights, int(b.CountAt(n)))
+			}
+		}
+	}
+	for _, h := range gateHeights {
+		if h <= squeezeFloor {
+			return true
+		}
+	}
+	return len(gateHeights) < 2
+}
